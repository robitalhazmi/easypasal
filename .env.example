# ==========================================
# EasyPasal Environment Configuration Template
# Copy this file to .env and fill in the values
# ==========================================

# Application Environment (development, staging, production)
EASYPASAL_ENV=development
EASYPASAL_LOG_LEVEL=INFO
EASYPASAL_HOST=0.0.0.0
EASYPASAL_PORT=8000

# Active Pipeline Variant Configuration (matches configs/variant_*.json or yaml)
EASYPASAL_VARIANT=baseline

# Log Collector (VPS Sink) Configuration
LOG_COLLECTOR_URL=http://localhost:8001
LOG_COLLECTOR_TOKEN=replace_with_collector_auth_token

# Vector Database (Qdrant) Configuration
# Leave empty or set to :memory: / local path for embedded mode
QDRANT_URL=
QDRANT_API_KEY=

# Hugging Face Token (Optional, for downloading gated models if required)
HF_TOKEN=
